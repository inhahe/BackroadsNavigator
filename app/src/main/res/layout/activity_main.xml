<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Map fills the entire screen -->
    <org.osmdroid.views.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Search bar at top -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_anchor="@id/map_view"
        app:layout_anchorGravity="top|center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Search"
                app:tint="@color/gray_600" />

            <EditText
                android:id="@+id/edit_search"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search destination..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="12dp"
                android:textSize="16sp"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/btn_clear_search"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                android:contentDescription="Clear search"
                app:tint="@color/gray_600" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Search results dropdown -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_results_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="68dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:layout_anchor="@id/map_view"
        app:layout_anchorGravity="top|center">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_search_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="300dp"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Navigation info panel at bottom -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navigation_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="88dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <include layout="@layout/navigation_panel" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Route summary panel (shown after route calc, before nav start) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/route_summary_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="88dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_route_distance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    tools:text="12.3 km" />

                <TextView
                    android:id="@+id/text_route_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_800"
                    tools:text="18 min" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_route_via"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="@color/gray_600"
                android:maxLines="2"
                tools:text="via Main St, 2nd Ave" />

            <!-- Save destination as Home / Work / Favorite -->
            <LinearLayout
                android:id="@+id/save_buttons_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save as:"
                    android:textSize="13sp"
                    android:textColor="@color/gray_500"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_home"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Home"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_home"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_work"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Work"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_work"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_favorite"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Fav"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_star"
                    app:iconSize="16dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel_route"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_show_directions_summary"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Steps"
                    app:icon="@drawable/ic_directions_list"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_start_navigation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Start"
                    android:backgroundTint="@color/green_600"
                    android:textColor="@android:color/white" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- FAB cluster at bottom right -->
    <LinearLayout
        android:id="@+id/fab_cluster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Excluded streets list -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_excluded_streets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_exclude"
            android:contentDescription="Excluded streets"
            app:fabSize="mini"
            app:backgroundTint="@color/gray_200"
            app:tint="@color/gray_800" />

        <!-- Backroads toggle -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_backroads"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_backroads"
            android:contentDescription="Toggle backroads mode"
            app:fabSize="mini"
            app:backgroundTint="@color/gray_200"
            app:tint="@color/gray_800" />

        <!-- Navigate home (tap = go home, long-press = set home) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_home"
            android:contentDescription="Navigate home"
            app:fabSize="mini"
            app:backgroundTint="@android:color/white"
            app:tint="@color/primary" />

        <!-- My location -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_my_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_my_location"
            android:contentDescription="My location"
            app:fabSize="mini"
            app:backgroundTint="@android:color/white"
            app:tint="@color/primary" />

        <!-- Navigate FAB (primary) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_navigate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_navigate"
            android:contentDescription="Calculate route"
            app:fabSize="normal"
            app:backgroundTint="@color/primary"
            app:tint="@android:color/white" />

    </LinearLayout>

    <!-- Bottom sheet for excluded streets -->
    <include layout="@layout/bottom_sheet_excluded_streets" />

    <!-- Bottom sheet for directions step list -->
    <include layout="@layout/bottom_sheet_directions" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
