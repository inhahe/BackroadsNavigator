<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_excluded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_background_top"
    android:padding="16dp"
    android:elevation="16dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
    app:behavior_hideable="true"
    app:behavior_peekHeight="0dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/rounded_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Excluded Streets"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/gray_900" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_all_excluded"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear All"
            android:textColor="@color/red_600" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_no_excluded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No excluded streets.\nLong-press on the map to exclude a street."
        android:textSize="14sp"
        android:textColor="@color/gray_500"
        android:gravity="center"
        android:padding="24dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_excluded_streets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="300dp"
        android:clipToPadding="false" />

</LinearLayout>
